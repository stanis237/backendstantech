# Variables d'environnement pour le projet STANTECH

# Remplacer par une clé secrète générée et ne jamais la committer en production
SECRET_KEY=replace-with-a-private-random-secret

# PythonAnywhere production: False. Pour le développement local: True.
DEBUG=False

# Domaine du backend PythonAnywhere
ALLOWED_HOSTS=stantechbackend.pythonanywhere.com,localhost,127.0.0.1

# URL du site frontend officiel (liens "Retour au site" depuis le dashboard)
FRONTEND_URL=https://www.stantechconsulting.site

# Origine du backend pour le formulaire de connexion Django
CSRF_TRUSTED_ORIGINS=https://stantechbackend.pythonanywhere.com

# Origines frontend autorisées pour CORS
CORS_ALLOW_ALL=False
CORS_ALLOWED_ORIGINS=https://www.stantechconsulting.site,https://fronts-theta.vercel.app

# Configuration de la base de données (Fournie par Railway en prod, laisse vide ou supprime pour utiliser SQLite en local)
# DATABASE_URL=postgres://user:password@host:port/dbname
